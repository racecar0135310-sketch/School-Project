# Copy this file to .env for local development and fill in your real values.
# On Render, set these as Environment Variables in the service settings
# instead of committing a .env file.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/school-diary?retryWrites=true&w=majority

# Protects the /dev portal, which can view and change every school's diary
# code and admin password. Pick your own strong value — this is not the
# same as any individual school's admin password.
DEV_PASSWORD=choose-your-own-strong-dev-password

# Always set a separate, random signing secret in production. If omitted, the
# server falls back to DEV_PASSWORD for backwards compatibility.
SESSION_SECRET=choose-a-separate-long-random-session-secret

# Optional comma-separated list of trusted frontend origins, e.g.
# CLIENT_ORIGIN=https://school.example.com,http://localhost:5173
# Leave unset for local development; configure it explicitly in production.
CLIENT_ORIGIN=

PORT=4000

# Optional one-time demo seed values. Keep these out of committed env files.
# Running `npm --prefix server run seed` with them set creates demo records;
# the seed exits rather than overwriting if the admin ID already exists.
# SEED_SCHOOL_NAME=Example School
# SEED_DIARY_CODE=example-diary-code
# SEED_ADMIN_ID=example-admin
# SEED_ADMIN_PASSWORD=use-a-unique-strong-password
# SEED_TEACHER_ID=example-teacher
# SEED_TEACHER_PASSWORD=use-a-unique-strong-password
# SEED_STUDENT_ID=example-student
# SEED_STUDENT_PASSWORD=use-a-unique-strong-password
