# Copy this file to .env for local development and fill in your real values.
# On Render, set these as Environment Variables in the service settings
# instead of committing a .env file.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/school-diary?retryWrites=true&w=majority

# Protects the /dev portal, which can view and change every school's diary
# code and admin password. Pick your own strong value — this is not the
# same as any individual school's admin password.
DEV_PASSWORD=choose-your-own-strong-dev-password

PORT=4000
