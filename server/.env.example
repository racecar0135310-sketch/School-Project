# Copy this file to .env for local development and fill in your real
# MongoDB connection string (from MongoDB Atlas, or wherever it's hosted).
# On Render, set this as an Environment Variable in the service settings
# instead of committing a .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/school-diary?retryWrites=true&w=majority
PORT=4000
