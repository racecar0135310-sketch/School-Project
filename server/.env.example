# Copy this file to .env (in this same /server folder) and fill in real values.
# Never commit the real .env file.

# Your MongoDB Atlas connection string.
MONGODB_URI=mongodb://user:password@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=xxxx&authSource=admin&retryWrites=true&w=majority

# Password for the /dev portal that manages every school. Pick your own —
# this is what protects the page that can see/change every school's codes.
DEV_PASSWORD=change-me

# Optional — Render sets this automatically in production.
PORT=4000