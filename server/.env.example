# Copy this file to .env (in this same /server folder) and fill in real values.
# Never commit the real .env file.

# Use this when MongoDB is installed locally:
# MONGODB_URI=mongodb://127.0.0.1:27017/schoolflow
# Or replace the line below with your MongoDB Atlas connection string:
MONGODB_URI=mongodb://user:password@host1:27017,host2:27017,host3:27017/?ssl=true&replicaSet=xxxx&authSource=admin&retryWrites=true&w=majority

# Password for the hidden /dev portal that creates schools and their first admins.
DEV_PASSWORD=change-me

# Used to sign 12-hour login sessions. Use a long random value in production.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional — Render sets this automatically in production.
PORT=4000
